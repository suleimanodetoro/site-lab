{
  "name": "site-lab",
  "version": "1.0.0",
  "description": "Capture any web page (every breakpoint, scroll motion, timed changes, hover, video, assets) so a coding agent can rebuild it 1:1 or extract its techniques.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/suleimanodetoro/site-lab.git"
  },
  "keywords": [
    "playwright",
    "web-capture",
    "scroll-animation",
    "gsap",
    "lenis",
    "design-study",
    "coding-agents"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "playwright install chromium webkit",
    "test": "npm run typecheck && npm run test:fixture && npm run test:browser",
    "capture": "tsx tool/capture.ts",
    "fix-names": "tsx tool/fix-names.ts",
    "compare": "tsx tool/compare.ts",
    "test:fixture": "tsx tool/test/run-fixture.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx tool/test/run-unit.ts",
    "test:browser": "tsx tool/test/run-browser-policy.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
